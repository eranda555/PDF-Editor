# Generate each secret independently with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not commit a real .env. All five remote providers require operator accounts.
DATABASE_URL=postgresql://pdf:pdf@localhost:5432/pdf
JWT_SECRET=
JWT_ISSUER=100-percent-pdf-suite
INTERNAL_TOKEN=
WORKER_HMAC_SECRET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=pdf-jobs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Optional. Cloud is disabled until explicitly enabled; no paid requests by default.
CLOUD_ENABLED=false
AI_ENABLED=false
GLOBAL_DAILY_JOBS=100
WORKER_URL=
# Used as the bearer credential, including the private Space edge when hosted there.
HF_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK=gemini-3.5-flash-lite
# Mandatory in hardened deployments. Requires unprivileged user/network namespaces.
REQUIRE_NETWORK_SANDBOX=true
# Android release signing environment variables; secrets are never in Gradle source.
PDF_SIGNING_KEYSTORE=
PDF_SIGNING_STORE_PASSWORD=
PDF_SIGNING_KEY_ALIAS=
PDF_SIGNING_KEY_PASSWORD=
